{
  "geode": "6.0.0",
  "gd": {
    "win": "2.2091",
    "android": "2.2091"
  },
  "id": "diamondsoup.diamondclicks",
  "name": "DiamondClicks",
  "version": "v1.0.0",
  "developer": "diamondsoup",
  "description": "Turns a held input into repeated clicks at a configurable interval.",
  "repository": "https://github.com/pholit228-spec/DiamondClicks",
  "tags": [
    "enhancement",
    "gameplay"
  ],
  "settings": {
    "enabled": {
      "type": "bool",
      "name": "DiamondClicks",
      "description": "Enable repeated clicking while a button is held.",
      "default": true
    },
    "delay": {
      "type": "int",
      "name": "Click delay (ms)",
      "description": "0 means every game update.",
      "default": 0,
      "min": 0,
      "max": 1000,
      "control": {
        "arrows": true,
        "arrow-step": 1,
        "slider": true,
        "slider-step": 1,
        "input": true
      }
    },
    "cube": {
      "type": "bool",
      "name": "Cube",
      "default": true
    },
    "ship": {
      "type": "bool",
      "name": "Ship",
      "default": true
    },
    "ball": {
      "type": "bool",
      "name": "Ball",
      "default": true
    },
    "ufo": {
      "type": "bool",
      "name": "UFO",
      "default": true
    },
    "wave": {
      "type": "bool",
      "name": "Wave",
      "default": true
    },
    "robot": {
      "type": "bool",
      "name": "Robot",
      "default": true
    },
    "spider": {
      "type": "bool",
      "name": "Spider",
      "default": true
    },
    "swing": {
      "type": "bool",
      "name": "Swing",
      "default": true
    },
    "platformer": {
      "type": "bool",
      "name": "Platformer",
      "default": false
    }
  }
}
